+import { applySerializedEventProperties } from '@/remote/elements/utils/applySerializedEventProperties';
+
+describe('applySerializedEventProperties', () => {
+  it('exposes dropped file bytes', () => {
+    const file = new File(['video bytes'], 'clip.mp4', { type: 'video/mp4' });
+    const event: Record<string, unknown> = {};
+
+    applySerializedEventProperties(event, {
+      type: 'drop',
+      transferFiles: [file],
+    });
+
+    const dataTransfer = event.dataTransfer as { files: File[] };
+    expect(dataTransfer.files[0]).toBe(file);
+    expect(dataTransfer.files[0]).toBeInstanceOf(File);
+    expect(dataTransfer.files[0].size).toBe(11);
+  });
+});
